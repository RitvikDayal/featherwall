<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- RootNamespace stays PrismOS so the moved files keep their PrismOS.* namespaces (and the
         embedded gallery resource keeps the name PrismOS.Gallery.gallery.json). -->
    <RootNamespace>PrismOS</RootNamespace>
    <AssemblyName>PrismOS.Core</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- System.Drawing (ImageRenderer, LockScreenWallpaper) comes from the Windows Desktop
         shared framework; no WinForms control is used here. -->
    <UseWindowsForms>true</UseWindowsForms>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Description>PrismOS engine: rendering, desktop integration, interop and configuration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Gallery\gallery.json" />
  </ItemGroup>

</Project>
